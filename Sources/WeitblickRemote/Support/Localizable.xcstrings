    },
    "%@: couldn’t be imported (%@)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: ließ sich nicht importieren (%@)."
          }
        }
      }
    },
    "%@: screenshots, mouse, keyboard and clipboard of this Windows session. The agent waits up to 2 minutes for your answer." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: Bildschirmfotos, Maus, Tastatur und Zwischenablage dieser Windows-Sitzung. Der Agent wartet bis zu 2 Minuten auf deine Antwort."
          }
        }
      }
    },
    "%lld changed" : {
