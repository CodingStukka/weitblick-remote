    "Agents connect through the weitblick-mcp helper. Each connection decides in its Security settings whether agents are asked about, always allowed or never allowed. Everything agents do is logged in ~/Library/Logs/Weitblick Remote/agent.log." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenten verbinden sich über das Hilfsprogramm weitblick-mcp. Jede Verbindung legt in ihren Sicherheitseinstellungen fest, ob bei Agenten nachgefragt wird, ob sie immer erlaubt oder nie erlaubt sind. Alles, was Agenten tun, wird in ~/Library/Logs/Weitblick Remote/agent.log protokolliert."
          }
        }
      }
    },
    "AI agent access" : {
      "localizations" : {
