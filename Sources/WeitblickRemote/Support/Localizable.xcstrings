    "A different certificate is saved for this connection. That happens after a reinstall or a new certificate, but it can also be an attack. Continue only if you know the reason." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese Verbindung ist ein anderes Zertifikat gespeichert. Das passiert nach einer Neuinstallation oder einem neuen Zertifikat, kann aber auch ein Angriff sein. Nur fortfahren, wenn der Grund bekannt ist."
          }
        }
      }
    },
    "About %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Über %@"
