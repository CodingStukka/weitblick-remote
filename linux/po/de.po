#: weitblick/rdp/session.py:111
msgid "Disconnected."
msgstr "Verbindung getrennt."

#: weitblick/rdp/session.py:112
msgid "Host unreachable."
msgstr "Host nicht erreichbar."

#: weitblick/rdp/session.py:113
msgid "Sign-in failed: wrong user name or password."
msgstr "Anmeldung fehlgeschlagen: Benutzername oder Passwort falsch."

#: weitblick/rdp/session.py:114
msgid "Sign-in failed: credentials missing."
msgstr "Anmeldung fehlgeschlagen: Zugangsdaten fehlen."

#: weitblick/rdp/session.py:115
msgid "Account locked."
msgstr "Konto gesperrt."

#: weitblick/rdp/session.py:116
msgid "Account disabled, expired or not allowed to sign in here."
msgstr "Konto deaktiviert, abgelaufen oder für diese Anmeldung nicht zugelassen."

#: weitblick/rdp/session.py:117
msgid "Password expired. Set a new password in Windows."
msgstr "Passwort abgelaufen. Bitte unter Windows ein neues Passwort setzen."

#: weitblick/rdp/session.py:118
msgid "Access denied: the user isn’t allowed to sign in via Remote Desktop."
msgstr "Zugriff verweigert: Der Benutzer darf sich nicht per Remotedesktop anmelden."

#: weitblick/rdp/session.py:120
msgid "Certificate rejected."
msgstr "Zertifikat abgelehnt."

#: weitblick/rdp/session.py:121
msgid "Secure connection failed (TLS/security negotiation)."
msgstr "Sichere Verbindung fehlgeschlagen (TLS/Sicherheitsaushandlung)."

#: weitblick/rdp/session.py:122
msgid "The server requires Network Level Authentication (NLA). Turn NLA on for this connection."
msgstr "Der Server verlangt Authentifizierung auf Netzwerkebene (NLA). Bitte NLA in der Verbindung einschalten."

#: weitblick/rdp/session.py:124
msgid "The server disconnected."
msgstr "Server hat getrennt."

#: weitblick/rdp/session.py:125
msgid "Another connection took over the session."
msgstr "Die Sitzung wurde von einer anderen Verbindung übernommen."

#: weitblick/rdp/session.py:126
msgid "Session ended in Windows."
msgstr "Sitzung unter Windows beendet."

#: weitblick/rdp/session.py:127
msgid "Timed out."
msgstr "Zeitüberschreitung."

#: weitblick/rdp/session.py:128
msgid "Connection lost."
msgstr "Verbindung unterbrochen."

#: weitblick/rdp/session.py:129
msgid "Connection ended."
msgstr "Verbindung beendet."

#: weitblick/store/draft.py:48
msgid "Enter a host."
msgstr "Bitte einen Host angeben."

#: weitblick/store/draft.py:50
msgid "The host can’t contain spaces."
msgstr "Der Host darf keine Leerzeichen enthalten."

#: weitblick/store/draft.py:52
msgid "The port must be between 1 and 65535."
msgstr "Der Port muss zwischen 1 und 65535 liegen."

#: weitblick/store/draft.py:56
msgid "The fixed resolution must be between 200 and 8192 pixels."
msgstr "Die feste Auflösung muss zwischen 200 und 8192 Pixeln liegen."

#: weitblick/store/jump.py:105
msgid "Not a list of texts; not imported."
msgstr "Keine Textliste; nicht übernommen."

#: weitblick/store/jump.py:117
msgid "Undocumented Jump code; not interpreted, the default stays."
msgstr "Undokumentierter Jump-Code; nicht gedeutet, der Standard bleibt."

#: weitblick/store/jump.py:118 weitblick/store/remmina.py:103
msgid "No equivalent; not imported."
msgstr "Keine Entsprechung; nicht übernommen."

#: weitblick/store/jump.py:148
msgid "Not a readable Jump file (no JSON object or larger than 4 MiB)."
msgstr "Keine lesbare Jump-Datei (kein JSON-Objekt oder größer als 4 MiB)."

#: weitblick/store/jump.py:163
msgid "UniqueId missing; without it a later import couldn’t be matched. Not imported."
msgstr "UniqueId fehlt; ohne sie ließe sich ein erneuter Import nicht zuordnen. Nicht übernommen."

#: weitblick/store/jump.py:168
msgid "Duplicate UniqueId in the Jump folder; this file was not imported."
msgstr "Doppelte UniqueId im Jump-Ordner; diese Datei wurde nicht übernommen."

#: weitblick/store/jump.py:173
msgid "Several saved connections belong to this Jump connection; clean them up first. Not imported."
msgstr "Mehrere gespeicherte Verbindungen gehören zu dieser Jump-Verbindung; bitte zuerst bereinigen. Nicht übernommen."

#: weitblick/store/jump.py:179
msgid "Unknown protocol (ProtocolTypeCode); not imported rather than guessed."
msgstr "Unbekanntes Protokoll (ProtocolTypeCode); nicht übernommen statt zu raten."

#: weitblick/store/jump.py:185
msgid "Host missing; not imported."
msgstr "Host fehlt; nicht übernommen."

#: weitblick/store/jump.py:218 weitblick/store/jump.py:144
msgid "File unreadable or invalid; nothing planned."
msgstr "Datei nicht lesbar oder ungültig; nichts geplant."

#: weitblick/store/jump.py:259
msgid "Audio: Jump’s code 2 read as “play on this computer”; please check."
msgstr "Audio: Jumps Code 2 als „auf diesem Computer abspielen“ gedeutet; bitte prüfen."

#: weitblick/store/jump.py:262
msgid "Unknown audio code {code}; audio playback turned off to be safe."
msgstr "Unbekannter Audio-Code {code}; Audio-Wiedergabe vorsichtshalber aus."

#: weitblick/store/jump.py:263
msgid "Unknown Jump value; playback off."
msgstr "Unbekannter Jump-Wert; Wiedergabe aus."

#: weitblick/store/jump.py:281
msgid "Not an object; drive not imported."
msgstr "Kein Objekt; Laufwerk nicht übernommen."

#: weitblick/store/jump.py:295
msgid "Name or path missing; drive not imported."
msgstr "Name oder Pfad fehlt; Laufwerk nicht übernommen."

#: weitblick/store/jump.py:299
msgid "Drive “{name}” is read-only in Jump and is not shared (sharing needs write access)."
msgstr "Laufwerk „{name}“ ist in Jump schreibgeschützt und wird nicht freigegeben (Freigaben gehen nur mit Schreibzugriff)."

#: weitblick/store/jump.py:314
msgid "Automatic layout detection takes precedence."
msgstr "Automatische Layout-Erkennung hat Vorrang."

#: weitblick/store/jump.py:32
msgid "The password isn’t in the Jump file; you’ll be asked for it on the first connection (Jump’s keychain stays untouched)."
msgstr "Passwort steht nicht in der Jump-Datei; beim ersten Verbinden wird danach gefragt (Jumps Schlüsselbund bleibt unberührt)."

#: weitblick/store/jump.py:322
msgid "No valid keyboard layout (KeyboardLocaleId); it is detected automatically."
msgstr "Kein gültiges Tastaturlayout (KeyboardLocaleId); es wird automatisch erkannt."

#: weitblick/store/jump.py:325
msgid "Reference to a Jump keyboard profile; the connection’s own keyboard settings apply."
msgstr "Verweis auf ein Jump-Tastaturprofil; es gelten die Tastatureinstellungen der Verbindung."

#: weitblick/store/jump.py:355
msgid "Gateway reference saved; the gateway settings themselves are not imported."
msgstr "Gateway-Verweis gespeichert, die Gateway-Einstellungen selbst werden nicht übernommen."

#: weitblick/store/jump.py:60
msgid "Not text; not imported."
msgstr "Kein Text; nicht übernommen."

#: weitblick/store/jump.py:69
msgid "Not a number; not imported."
msgstr "Keine Zahl; nicht übernommen."

#: weitblick/store/jump.py:78 weitblick/store/remmina.py:74
msgid "Not an integer; not imported."
msgstr "Keine ganze Zahl; nicht übernommen."

#: weitblick/store/jump.py:87 weitblick/store/remmina.py:87
msgid "Not a yes/no value; not imported."
msgstr "Kein Ja/Nein-Wert; nicht übernommen."

#: weitblick/store/jump.py:96
msgid "Not a list; not imported."
msgstr "Keine Liste; nicht übernommen."

#: weitblick/store/library.py:44
msgid "The connections in “{path}” couldn’t be read. The file stays unchanged."
msgstr "Die Verbindungen in „{path}“ ließen sich nicht lesen. Die Datei bleibt unverändert."

#: weitblick/store/library.py:95 weitblick/store/store.py:179
msgid "{name} copy"
msgstr "{name} Kopie"

#: weitblick/store/rdpfile.py:109
msgid "Line {number} unreadable; ignored."
msgstr "Zeile {number} unlesbar; ignoriert."

#: weitblick/store/rdpfile.py:113
msgid "Saved password in the file ignored; you’ll be asked for it when connecting."
msgstr "Gespeichertes Passwort in der Datei ignoriert; beim Verbinden wird danach gefragt."

#: weitblick/store/rdpfile.py:116
msgid "Field {key} appears twice; the last value applies."
msgstr "Feld {key} doppelt; der letzte Wert gilt."

#: weitblick/store/rdpfile.py:156
msgid "The file’s drive selection (Windows drives) is not imported as local folders; share folders yourself."
msgstr "Die Laufwerksauswahl der Datei (Windows-Laufwerke) wird nicht als lokale Ordner übernommen; Ordner bitte selbst freigeben."

#: weitblick/store/rdpfile.py:174
msgid "Setting not supported; not imported."
msgstr "Einstellung wird nicht unterstützt; nicht übernommen."

#: weitblick/store/remmina.py:101
msgid "Saved password; not imported."
msgstr "Gespeichertes Passwort; nicht übernommen."

#: weitblick/store/remmina.py:153
msgid "Not a readable Remmina file; nothing planned."
msgstr "Keine lesbare Remmina-Datei; nichts geplant."

#: weitblick/store/remmina.py:168
msgid "Several saved connections belong to this Remmina connection; clean them up first. Not imported."
msgstr "Zu dieser Remmina-Verbindung gehören mehrere gespeicherte Verbindungen; bitte zuerst aufräumen. Nicht übernommen."

#: weitblick/store/remmina.py:178
msgid "Only RDP and VNC connections are imported; this one is not."
msgstr "Nur RDP- und VNC-Verbindungen werden übernommen; diese nicht."

#: weitblick/store/remmina.py:180
msgid "Protocol not supported."
msgstr "Protokoll nicht unterstützt."

#: weitblick/store/remmina.py:184
msgid "Host missing or invalid; not imported."
msgstr "Host fehlt oder ist ungültig; nicht übernommen."

#: weitblick/store/remmina.py:186
msgid "Not a host name or address."
msgstr "Kein Rechnername und keine Adresse."

#: weitblick/store/remmina.py:209
msgid "Settings out of range; not imported."
msgstr "Einstellungen außerhalb des gültigen Bereichs; nicht übernommen."

#: weitblick/store/remmina.py:266 weitblick/store/remmina.py:249 weitblick/store/remmina.py:286
msgid "Unknown Remmina value; the default stays."
msgstr "Unbekannter Remmina-Wert; die Voreinstellung bleibt."

#: weitblick/store/remmina.py:298
msgid "RD Gateway saved, but Weitblick Remote can’t connect through a gateway yet."
msgstr "RD-Gateway gespeichert, aber Weitblick Remote kann noch nicht über ein Gateway verbinden."

#: weitblick/store/remmina.py:45
msgid "Remmina’s saved password isn’t imported; you’ll be asked for it on the first connection."
msgstr "Das in Remmina gespeicherte Passwort wird nicht übernommen; beim ersten Verbinden wird danach gefragt."

